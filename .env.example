# Copy this file to .env and adjust values for your environment.

# Port 3011 is already used by FreeSchool in the shared microservice
# architecture (see MSArchitecture.md) - this app uses a different one.
PORT=4100
HOST=0.0.0.0
# INWO has no live domain wired up yet; replace once one exists.
SITE_URL=https://inwo.example

# Prepared for Phase 2 (content management). Not used by Phase 1 routes yet.
MONGODB_URI=mongodb://localhost:27017/inwo

{% extends "layout.njk" %}
{% block content %}
<section class="section section--form" data-theme="light">
  <div class="section__inner section__inner--narrow">
    <h1>Mitgliedsantrag</h1>
    <p class="section__intro">Werde Teil der INWO und unterstütze die Idee einer fairen Geld- und Bodenordnung.</p>

    {% if success %}
      <div class="form-message form-message--success" role="status">
        <strong>Vielen Dank!</strong> Dein Mitgliedsantrag wurde übermittelt. Wir melden uns in Kürze bei dir.
      </div>
    {% else %}
      {% if error %}
        <div class="form-message form-message--error" role="alert">{{ error }}</div>
      {% endif %}

      <form class="mitgliedsantrag-form" method="post" action="/mitgliedsantrag" novalidate>
        <fieldset class="form-group">
          <legend>Mitgliedschaftsart *</legend>
          <label class="choice">
            <input type="radio" name="mitgliedschaft" value="mitglied" {% if values.mitgliedschaft == "mitglied" %}checked{% endif %} />
            <span>Vollmitglied</span>
          </label>
          <label class="choice">
            <input type="radio" name="mitgliedschaft" value="foerdermitglied" {% if not values.mitgliedschaft or values.mitgliedschaft == "foerdermitglied" %}checked{% endif %} />
            <span>Fördermitglied</span>
          </label>
        </fieldset>

        <div class="form-grid">
          <label class="field field--full">
            <span>Anrede</span>
            <select name="anrede">
              <option value="">Keine Angabe</option>
              <option value="Herr" {% if values.anrede == "Herr" %}selected{% endif %}>Herr</option>
              <option value="Frau" {% if values.anrede == "Frau" %}selected{% endif %}>Frau</option>
              <option value="Divers" {% if values.anrede == "Divers" %}selected{% endif %}>Divers</option>
            </select>
          </label>

          <label class="field">
            <span>Vorname *</span>
            <input type="text" name="vorname" required autocomplete="given-name" value="{{ values.vorname or '' }}" />
          </label>

          <label class="field">
            <span>Nachname *</span>
            <input type="text" name="nachname" required autocomplete="family-name" value="{{ values.nachname or '' }}" />
          </label>

          <label class="field">
            <span>Geburtsdatum</span>
            <input type="date" name="geburtsdatum" value="{{ values.geburtsdatum or '' }}" />
          </label>

          <label class="field field--full">
            <span>Straße &amp; Hausnummer *</span>
            <input type="text" name="strasse" required autocomplete="street-address" value="{{ values.strasse or '' }}" />
          </label>

          <label class="field">
            <span>PLZ *</span>
            <input type="text" name="plz" required autocomplete="postal-code" value="{{ values.plz or '' }}" />
          </label>

          <label class="field">
            <span>Ort *</span>
            <input type="text" name="ort" required autocomplete="address-level2" value="{{ values.ort or '' }}" />
          </label>

          <label class="field">
            <span>Land</span>
            <input type="text" name="land" autocomplete="country-name" value="{{ values.land or 'Deutschland' }}" />
          </label>

          <label class="field">
            <span>E-Mail *</span>
            <input type="email" name="email" required autocomplete="email" value="{{ values.email or '' }}" />
          </label>

          <label class="field">
            <span>Telefon</span>
            <input type="tel" name="telefon" autocomplete="tel" value="{{ values.telefon or '' }}" />
          </label>

          <label class="field">
            <span>Gewünschter Beitrag</span>
            <input type="text" name="beitrag" value="{{ values.beitrag or '' }}" />
          </label>
        </div>

        <label class="field field--full">
          <span>Nachricht</span>
          <textarea name="nachricht" rows="4">{{ values.nachricht or '' }}</textarea>
        </label>

        <label class="consent">
          <input type="checkbox" name="datenschutz" value="1" required />
          <span>Ich stimme der Verarbeitung meiner Daten gemäß der <a href="/datenschutz">Datenschutzerklärung</a> zu. *</span>
        </label>

        <button type="submit" class="btn btn--accent">Antrag absenden</button>
      </form>
    {% endif %}
  </div>
</section>
{% endblock %}

<section id="inwo" class="section" data-theme="{{ inwo.theme }}">
  <div class="section__inner">
    <h2 class="reveal reveal--up" data-edit-path="inwo.title" data-edit-label="INWO · Überschrift">{{ inwo.title }}</h2>
    <p class="section__intro reveal reveal--up" data-edit-path="inwo.intro" data-edit-label="INWO · Einleitung">{{ inwo.intro }}</p>

    <div class="pitch-video reveal reveal--up">
      <button type="button" class="btn btn--ghost" id="pitch-video-trigger"><span data-edit-path="inwo.pitchVideo.label" data-edit-label="INWO · Video-Button">{{ inwo.pitchVideo.label }}</span></button>
      <p class="note note--on-dark" data-edit-path="inwo.pitchVideo.note" data-edit-label="INWO · Video-Hinweis">{{ inwo.pitchVideo.note }}</p>
      <a class="link-more" href="{{ inwo.pitchVideo.transcriptHref }}"><span data-edit-path="inwo.pitchVideo.transcriptLabel" data-edit-label="INWO · Transkript-Link">{{ inwo.pitchVideo.transcriptLabel }}</span></a>
    </div>

    <div class="theory-cards">
      {% for theory in inwo.theories %}
      <article class="theory-card reveal reveal--up">
        <h3 data-edit-path="inwo.theories.{{ loop.index0 }}.title" data-edit-label="INWO · Theorie {{ loop.index }}">{{ theory.title }}</h3>
        <p data-edit-path="inwo.theories.{{ loop.index0 }}.text" data-edit-label="INWO · Theorie {{ loop.index }} Text">{{ theory.text }}</p>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

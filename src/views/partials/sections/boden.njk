<section id="boden" class="section" data-theme="{{ boden.theme }}">
  <div class="section__inner">
    <h2 class="reveal reveal--left">{{ boden.title }}</h2>
    <p class="section__intro reveal reveal--left">{{ boden.intro }}</p>
    <p class="note">{{ boden.statusNote }}</p>

    <ol class="scene-list">
      {% for scene in boden.scenes %}
      <li class="scene reveal reveal--left">
        <h3>{{ scene.title }}</h3>
        <p>{{ scene.text }}</p>
      </li>
      {% endfor %}
    </ol>

    <a class="link-more" href="{{ boden.readMore.href }}">{{ boden.readMore.label }}</a>
    <p class="call-ref"><a href="{{ boden.callRef.href }}">{{ boden.callRef.label }}</a></p>
  </div>
</section>

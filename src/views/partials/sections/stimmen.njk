{% if stimmen.enabled %}
<section id="stimmen" class="section" data-theme="{{ stimmen.theme }}">
  <div class="section__inner">
    <h2 class="reveal reveal--up">{{ stimmen.title }}</h2>
    <p class="section__intro reveal reveal--up">{{ stimmen.intro }}</p>
    <div class="testimonial-cards">
      {% for testimonial in stimmen.testimonials %}
      <article class="testimonial-card reveal reveal--up">
        <p>{{ testimonial.quote }}</p>
        <p class="testimonial-card__name">{{ testimonial.name }}</p>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

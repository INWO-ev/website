<section id="aktuell" class="section" data-theme="{{ aktuell.theme }}">
  <div class="section__inner">
    <h2 class="reveal reveal--up" data-edit-path="aktuell.title" data-edit-label="Aktuell · Überschrift">{{ aktuell.title }}</h2>

    <div class="aktuell-grid">
      <div class="aktuell-col reveal reveal--up">
        <h3 data-edit-path="aktuell.events.heading" data-edit-label="Aktuell · Spalte Veranstaltungen">{{ aktuell.events.heading }}</h3>
        <ul class="aktuell-list">
          {% for event in aktuellData.events %}
          <li>
            <a href="{{ event.link }}"><span data-edit-path="events.{{ loop.index0 }}.titel" data-edit-label="Aktuell · Termin {{ loop.index }}">{{ event.titel }}</span></a>
            <span class="aktuell-list__meta">{{ event.start }} · <span data-edit-path="events.{{ loop.index0 }}.ort" data-edit-label="Aktuell · Ort Termin {{ loop.index }}">{{ event.ort }}</span></span>
          </li>
          {% endfor %}
        </ul>
        <a class="link-more" href="{{ aktuell.events.allHref }}"><span data-edit-path="aktuell.events.allLabel" data-edit-label="Aktuell · Link alle Termine">{{ aktuell.events.allLabel }}</span></a>
        <a class="link-more" href="{{ aktuell.events.icalHref }}"><span data-edit-path="aktuell.events.icalLabel" data-edit-label="Aktuell · iCal-Link">{{ aktuell.events.icalLabel }}</span></a>
      </div>

      <div class="aktuell-col reveal reveal--up">
        <h3 data-edit-path="aktuell.posts.heading" data-edit-label="Aktuell · Spalte Beiträge">{{ aktuell.posts.heading }}</h3>
        <ul class="aktuell-list">
          {% for post in aktuellData.posts %}
          <li>
            <a href="/blog/{{ post.slug }}"><span data-edit-path="posts.{{ loop.index0 }}.titel" data-edit-label="Aktuell · Beitrag {{ loop.index }}">{{ post.titel }}</span></a>
            <span class="aktuell-list__meta"><span data-edit-path="posts.{{ loop.index0 }}.veroeffentlicht_am" data-edit-label="Aktuell · Datum Beitrag {{ loop.index }}">{{ post.veroeffentlicht_am }}</span></span>
            <p data-edit-path="posts.{{ loop.index0 }}.teaser" data-edit-label="Aktuell · Teaser Beitrag {{ loop.index }}">{{ post.teaser }}</p>
          </li>
          {% endfor %}
        </ul>
        <a class="link-more" href="{{ aktuell.posts.allHref }}"><span data-edit-path="aktuell.posts.allLabel" data-edit-label="Aktuell · Link alle Beiträge">{{ aktuell.posts.allLabel }}</span></a>
        <a class="link-more" href="{{ aktuell.posts.rssHref }}"><span data-edit-path="aktuell.posts.rssLabel" data-edit-label="Aktuell · RSS-Link">{{ aktuell.posts.rssLabel }}</span></a>
      </div>

      <div class="aktuell-col reveal reveal--up">
        <h3 data-edit-path="aktuell.videos.heading" data-edit-label="Aktuell · Spalte YouTube">{{ aktuell.videos.heading }}</h3>
        <p class="note" data-edit-path="aktuell.videos.note" data-edit-label="Aktuell · YouTube-Hinweis">{{ aktuell.videos.note }}</p>
      </div>
    </div>
  </div>
</section>

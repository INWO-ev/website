<section id="start" class="section section--hero" data-theme="{{ hero.theme }}" data-hero-video="/public/video/hero.mp4">
  <img class="section--hero__emblem" src="/public/img/fairconomy-emblem.png" alt="" aria-hidden="true" />

  <div class="section__inner section--hero__inner reveal reveal--fade">
    <p class="eyebrow">Fairconomy</p>
    <h1>{{ hero.headline }}</h1>
    <p class="section--hero__subline">{{ hero.subline }}</p>
    <p class="section--hero__intro">{{ hero.intro }}</p>
    <div class="cta-group">
      <a class="btn btn--accent btn--lg" href="{{ hero.primaryCta.href }}">{{ hero.primaryCta.label }}</a>
      <a class="btn btn--ghost btn--lg" href="{{ hero.secondaryCta.href }}">{{ hero.secondaryCta.label }}</a>
    </div>
  </div>
</section>

<header class="site-nav" id="site-nav" data-nav-theme="dark">
  <div class="site-nav__inner">
    <a class="site-nav__brand" href="/">
      <img class="site-nav__brand-logo" src="/public/img/inwo-logo.png" alt="" aria-hidden="true" width="40" height="40" />
      <span class="site-nav__brand-text">
        <span class="site-nav__brand-main">{{ nav.brand }}</span>
        <span class="site-nav__brand-sub">{{ nav.brandSub }}</span>
      </span>
    </a>

    <nav class="site-nav__anchors" aria-label="Abschnitte dieser Seite">
      <ul>
        {% for anchor in nav.anchors %}
        <li><a href="#{{ anchor.id }}" data-anchor="{{ anchor.id }}">{{ anchor.label }}</a></li>
        {% endfor %}
      </ul>
    </nav>

    <div class="site-nav__actions">
      <button
        type="button"
        class="theme-toggle"
        id="theme-toggle"
        aria-pressed="false"
        aria-label="Hellen Modus aktivieren"
        title="Hellen Modus aktivieren"
      >
        <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
        <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="5" />
          <line x1="12" y1="1" x2="12" y2="3" />
          <line x1="12" y1="21" x2="12" y2="23" />
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
          <line x1="1" y1="12" x2="3" y2="12" />
          <line x1="21" y1="12" x2="23" y2="12" />
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
        </svg>
      </button>
      <a class="btn btn--accent site-nav__cta" href="{{ nav.ctaHref }}">{{ nav.ctaLabel }}</a>
      <button
        type="button"
        class="hamburger"
        id="hamburger-toggle"
        aria-label="Menü öffnen"
        aria-expanded="false"
        aria-controls="overlay-menu"
      >
        <span class="hamburger__bar"></span>
        <span class="hamburger__bar"></span>
        <span class="hamburger__bar"></span>
      </button>
    </div>
  </div>
</header>

<div class="overlay-menu" id="overlay-menu" hidden>
  <div class="overlay-menu__inner" role="dialog" aria-modal="true" aria-label="Hauptmenü">
    <button type="button" class="overlay-menu__close" id="overlay-menu-close" aria-label="Menü schließen">×</button>
    <ul>
      {% for link in nav.overlayLinks %}
      <li><a href="{{ link.href }}">{{ link.label }}</a></li>
      {% endfor %}
    </ul>
  </div>
</div>
